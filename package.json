{
  "name": "relay-server",
  "version": "0.1.0",
  "main": "server.js",
  "description": "Real-time communication server: chat, push-to-talk channels, 1:1 calls, and group conferencing over WebRTC (mediasoup) and Socket.IO.",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/infrastructure/db/init.js"
  },
  "nodemonConfig": {
    "ignore": [
      "recordings/**",
      "uploads/**"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.19.16",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
