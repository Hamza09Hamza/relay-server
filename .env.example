# Copy this file to .env and fill in real values before running the server.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
# HOST defaults to 0.0.0.0 in development and 127.0.0.1 (behind a reverse
# proxy) otherwise. Only set this if your deployment topology needs it.
# HOST=127.0.0.1
NODE_ENV=development

# Comma-separated list of allowed browser/Electron origins for CORS.
# Defaults to https://example.com:8443,https://example.com if unset.
CORS_ORIGINS=https://example.com:8443,https://example.com

# Public/LAN IP advertised to WebRTC clients for ICE candidates. Leave unset
# to auto-detect the local network interface (fine for LAN-only testing).
# ANNOUNCED_IP=203.0.113.10

# ── Auth ─────────────────────────────────────────────────────────────────
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access-token lifetime (jsonwebtoken duration string, e.g. 60d, 1h, 900s).
ACCESS_TOKEN_TTL=60d
# Refresh-token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=180

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=relay
DB_USER=postgres
DB_PASSWORD=postgres

# ── Data-at-rest encryption ─────────────────────────────────────────────
# AES-256-GCM key for encrypting uploads/recordings at rest. Optional —
# without it, files are stored unencrypted. Generate the same way as JWT_SECRET.
# ENCRYPTION_MASTER_KEY=

# ── Redis (optional, multi-instance Socket.IO fan-out) ──────────────────
# Leave unset for a single-instance deployment (in-memory adapter, no-op).
# REDIS_URL=redis://localhost:6379
# CALL_STATE_BACKEND=memory

# ── Hop-in (device-handoff camera signalling) ───────────────────────────
# Optional TURN/STUN servers as a JSON array, e.g.
# [{"urls":"stun:stun.example.com:3478"}]. Empty defaults to same-LAN ICE.
HOP_IN_ICE_SERVERS_JSON=[]

# ── Recording / transcoding tuning (all optional) ───────────────────────
# RECORDING_COMBINE_NORMALIZED=false
# RECORDING_USE_CLIENT_TIMELINE=true
# RECORDING_WRITE_COMBINE_DEBUG=false
# RECORDING_VERBOSE_LOGS=false
# TRANSCODING_MAX_CORES=
# TRANSCODING_THREADS=
# TRANSCODING_PRESET=
# TRANSCODING_CRF=
# TRANSCODING_NICE=

# ── Verbose logging (all optional, default false) ───────────────────────
# VERBOSE_SOCKET_LOGS=false
# VERBOSE_MEDIA_LOGS=false
# VERBOSE_CALL_LOGS=false
# DEBUG_LOG=false
